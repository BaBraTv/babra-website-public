DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/babra_store?schema=public"
NEXT_PUBLIC_SITE_URL="https://babra.store"
PRODUCTION_APP_URL="https://www.babra.store"

# Authentication
AUTH_SESSION_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_SECRET="replace-with-a-long-random-secret-if-nextauth-is-added-later"
PASSWORD_RESET_TOKEN_SECRET="replace-with-a-long-random-secret"
ADMIN_SETUP_SECRET="replace-with-a-long-random-secret-for-first-admin-setup"

# Email notifications
EMAIL_FROM="BaBra Store <no-reply@babra.store>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="true"

# Rwanda-compatible payment gateway placeholders
PAYMENT_CALLBACK_SECRET="replace-with-a-long-random-secret"
MTN_MOMO_BASE_URL=""
MTN_MOMO_SUBSCRIPTION_KEY=""
MTN_MOMO_API_USER=""
MTN_MOMO_API_KEY=""
